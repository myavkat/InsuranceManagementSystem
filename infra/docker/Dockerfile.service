# Runtime-only image for InsuranceManagementSystem microservices.
# Expects the service JAR to be pre-built on the host (./gradlew bootJar -x test).
# Usage: docker build --build-arg JAR_PATH=services/customer-service/build/libs/customer-service-0.0.1-SNAPSHOT.jar -f infra/docker/Dockerfile.service .
FROM eclipse-temurin:25-jre-alpine
ARG JAR_PATH
WORKDIR /app
COPY ${JAR_PATH} app.jar
EXPOSE 8080
ENTRYPOINT ["java", "-Xmx256m", "-Xms128m", "-jar", "app.jar"]
